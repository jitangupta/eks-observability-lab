apiVersion: v1
kind: Service
metadata:
  name: cartservice
  namespace: online-boutique
  labels:
    app.kubernetes.io/name: cartservice
    app.kubernetes.io/part-of: online-boutique
    lab.openai.com/cluster: c1
    lab.openai.com/temporary-workaround: nodeport
spec:
  ports:
  - name: grpc-cart
    protocol: TCP
    port: 7070
    targetPort: 30770
---
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: cartservice-nodeport-fallback
  namespace: online-boutique
  labels:
    kubernetes.io/service-name: cartservice
    endpointslice.kubernetes.io/managed-by: eks-observability-lab-phase5-fallback
    lab.openai.com/cluster: c1
    lab.openai.com/temporary-workaround: nodeport
addressType: IPv4
ports:
- name: grpc-cart
  protocol: TCP
  port: __C2_CART_NODE_PORT__
endpoints:
- addresses:
  - "__C2_NODE_PRIVATE_IP__"
  conditions:
    ready: true
